# Copy to .env; never commit .env. Local development only.
# These are placeholder values for a throwaway local stack, not real credentials.
# Session/JWT secrets are generated by the ckan-dev image at start-up.

# Host port for CKAN
CKAN_PORT_HOST=5000

# PostgreSQL superuser (db container)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# CKAN role and databases (created by docker/postgres/initdb)
CKAN_DB_USER=ckan_default
CKAN_DB_PASSWORD=pass
CKAN_DB=ckan_default
CKAN_TEST_DB=ckan_test

# CKAN connections
CKAN_SQLALCHEMY_URL=postgresql://ckan_default:pass@db/ckan_default
CKAN_SOLR_URL=http://solr:8983/solr/ckan
CKAN_REDIS_URL=redis://redis:6379/1

# Test connections, used by docker/ckan/test-env.sh, which exports them as the
# CKAN_* variables for test commands. They are not written into test-core.ini.
TEST_CKAN_SQLALCHEMY_URL=postgresql://ckan_default:pass@db/ckan_test
TEST_CKAN_SOLR_URL=http://solr-test:8983/solr/ckan
TEST_CKAN_REDIS_URL=redis://redis:6379/2

# CKAN site
CKAN_SITE_ID=default
CKAN_SITE_URL=http://localhost:5000
CKAN_STORAGE_PATH=/var/lib/ckan
CKAN__SITE_TITLE="AuScope Core Development"

# Local sysadmin created at start-up
CKAN_SYSADMIN_NAME=ckan_admin
CKAN_SYSADMIN_PASSWORD=change-me-local-only
CKAN_SYSADMIN_EMAIL=admin@example.com

USE_HTTPS_FOR_DEV=false
TZ=UTC

# envvars must be last
CKAN__PLUGINS="auscope_core image_view text_view datatables_view envvars"
